# Prefer the control plane's LAN/local URL for workers on the same network.
SIGNCLOUD_SERVER=http://localhost:18787
SIGNCLOUD_AGENT_TOKEN=must-match-control-plane
SIGNCLOUD_WORKER_ID=mac-builder-01
SIGNCLOUD_WORK_ROOT=/Users/buildbot/SignCloudWork
SIGNCLOUD_CACHE_ROOT=/Users/buildbot/SignCloudCache
SIGNCLOUD_CACHE_MAX_GB=100
SIGNCLOUD_CACHE_TTL_HOURS=336
SIGNCLOUD_POLL_SECONDS=1

# Optional dependency-download acceleration through a local HTTP proxy.
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1
NPM_CONFIG_CACHE=/Users/buildbot/SignCloudCache/dependencies/npm
CP_HOME_DIR=/Users/buildbot/SignCloudCache/dependencies/cocoapods
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# The Apple Team ID is the 10-character identifier, not the organization name.
APPLE_TEAM_ID=
IOS_EXPORT_METHOD=development
IOS_SIGNING_IDENTITY=Apple Development
IOS_WILDCARD_PROFILE=SignCloud Wildcard Development
# Recommended: create an isolated keychain for each signing job, import the
# P12 only for that job, and delete the keychain after success or failure.
IOS_EPHEMERAL_KEYCHAIN=true
IOS_SIGNING_P12_PATH=/Users/buildbot/Signing/apple-development.p12
IOS_SIGNING_P12_PASSWORD_FILE=/Users/buildbot/Signing/p12-password

# Legacy persistent-keychain mode. Leave unset when ephemeral mode is enabled.
# IOS_KEYCHAIN_PATH=/Users/buildbot/Signing/signcloud.keychain-db
# IOS_KEYCHAIN_PASSWORD_FILE=/Users/buildbot/Signing/keychain-password

# Required only for resign jobs. Keep this file on the macOS worker.
IOS_PROVISIONING_PROFILE=/Users/buildbot/Signing/App.mobileprovision

# Required for AI-assisted device enrollment. Also used by xcodebuild when
# automatic provisioning is enabled for a task. Keep these only on the worker.
APPLE_API_KEY_PATH=/Users/buildbot/Signing/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=
# Override only for integration tests or an explicit compatible proxy.
# APPLE_API_BASE_URL=https://api.appstoreconnect.apple.com

# macOS Developer ID distribution. The client never receives these values.
# Prefer a certificate SHA-256 fingerprint as the identity selector.
MACOS_DEVELOPER_ID_IDENTITY=
MACOS_KEYCHAIN_PATH=/Users/buildbot/Signing/developer-id.keychain-db
MACOS_KEYCHAIN_PASSWORD_FILE=/Users/buildbot/Signing/developer-id-keychain-password
# Store notarization credentials once with `xcrun notarytool store-credentials`.
MACOS_NOTARY_KEYCHAIN_PROFILE=signcloud-notary
# Increment whenever the certificate/keychain/notary configuration changes.
MACOS_SIGNING_CONFIG_VERSION=1
# Allows only `xcodegen generate` when project.yml exists and no Xcode container exists.
MACOS_XCODEGEN_ENABLED=false

# Extra Xcode locations for builds that pass spec.xcode_version. Defaults to
# /Applications/Xcode*.app plus the active xcode-select installation. Entries
# are colon-separated and may be glob patterns; install Xcode 26 and 27 side by
# side as /Applications/Xcode_26.6.app and /Applications/Xcode_27.app.
# SIGNCLOUD_XCODE_PATHS=/Applications/Xcode*.app

# Cloud simulator verification (kind=verify). Requires simlock gateway + worker
# on this Mac; see scripts/setup-simlock-host.sh.
# The gateway binds to the host's LAN address by default so the control
# container can reach it; use that address here (127.0.0.1 also works for the
# worker alone but not from Docker).
SIGNCLOUD_AGENT_DEVICE_URL=http://192.0.2.20:4700/v1/agent-device
# Gateway token with the "agent" role. Never commit the real value.
SIGNCLOUD_AGENT_DEVICE_TOKEN=
# Absolute path is recommended for launchd jobs.
SIGNCLOUD_AGENT_DEVICE_BIN=/Users/buildbot/.nvm/versions/node/v22.19.0/bin/agent-device
SIGNCLOUD_SIMLOCK_GATEWAY_URL=http://192.0.2.20:4700
