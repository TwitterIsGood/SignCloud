SIGNCLOUD_API_TOKEN=replace-with-a-long-random-token
SIGNCLOUD_API_TOKENS=optional-second-token,optional-third-token
SIGNCLOUD_AGENT_TOKEN=replace-with-a-different-long-random-token
SIGNCLOUD_DOMAIN=build.example.com
SIGNCLOUD_PUBLIC_BASE_URL=https://build.example.com
SIGNCLOUD_LISTEN_ADDR=:8787
SIGNCLOUD_STORAGE_DIR=/data
SIGNCLOUD_MAX_UPLOAD_MB=2048
SIGNCLOUD_MAX_DEVICES_PER_TOKEN=3
SIGNCLOUD_DEVICE_ENROLLMENT_ENABLED=false
POSTGRES_DB=signcloud
POSTGRES_USER=signcloud
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgres://signcloud:replace-with-a-long-database-password@postgres:5432/signcloud?sslmode=disable
